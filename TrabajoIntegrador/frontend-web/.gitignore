# =========================================================
#  .gitignore - frontend-web (Create React App)
#  Ver https://help.github.com/articles/ignoring-files/
# =========================================================

# Dependencias
/node_modules
/.pnp
.pnp.js

# Tests y cobertura
/coverage

# Build de producción
/build
/dist
/out

# Variables de entorno (nunca subir secretos)
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Cachés y archivos temporales
.eslintcache
.stylelintcache
.cache/
.npm/
*.tsbuildinfo
*.tmp
*.temp
*.bak
*.orig
*~

# Archivos del sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Herramientas de asistentes de IA
.claude/
.cursor/
.aider*

# Storybook
storybook-static/

# Archivos comprimidos
*.zip
*.rar
*.7z
