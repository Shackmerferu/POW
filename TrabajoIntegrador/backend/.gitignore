# =========================================================
#  .gitignore - backend (Node.js / Express)
# =========================================================

# Dependencias
node_modules/
.pnp
.pnp.js

# Variables de entorno (nunca subir secretos)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cachés y archivos temporales
.npm/
.cache/
.eslintcache
*.tsbuildinfo
*.tmp
*.temp
*.bak
*.orig
*~

# Tests y cobertura
coverage/
.nyc_output/

# Build / artefactos
build/
dist/
out/

# Archivos subidos por usuarios en tiempo de ejecución
# (las muestras ya versionadas siguen bajo control de git)
uploads/

# Bases de datos locales / dumps
*.sqlite
*.sqlite3
*.db

# Archivos del sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Herramientas de asistentes de IA
.claude/
.cursor/
.aider*

# Archivos comprimidos
*.zip
*.rar
*.7z
