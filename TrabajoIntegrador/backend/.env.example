# Configuración de EJEMPLO (sin secretos reales).
# Copiá este archivo como ".env" en la carpeta backend/ y completá los
# valores reales de tu entorno. El archivo .env NO se sube al repositorio
# (ver .gitignore): ahí viven los secretos, nunca en el código.

# Secreto de firma y verificación de los JWT. En producción debe ser
# una cadena larga y aleatoria, distinta por instalación.
JWT_SECRETO=cambiar-este-valor-por-un-secreto-largo-y-aleatorio

# Puerto del servidor Express.
PORT=8000

# Conexión a MySQL.
DB_HOST=localhost
DB_USUARIO=root
DB_CONTRASENA=
DB_NOMBRE=gestion_convenios
